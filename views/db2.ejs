<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅の詳細</h2>
  <table>
    <thead>
      <tr><th>ID</th><th>駅コード</th><th>駅名</th></tr>
    </thead>
    <tbody>
      <% for( let row of data ) { %>
        <tr>
          <td><%= row.id %></td>
          <td><%= row.code %></td>
          <td><%= row.name %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</body>
</html>