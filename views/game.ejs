<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>好きなゲームの一覧</title>
</head>
<body>
  <h2>好きなゲームの一覧</h2>
  <table>
    <thead>
      <tr><th>ID</th><th>タイトル</th><th>機種</th><th>ジャンル</th></tr>
    </thead>
    <tbody>
      <% for( let row of data ) { %>
        <tr>
          <td><%= row.id %></td>
          <td><%= row.title %></td>
          <td><%= row.platform %></td>
          <td><%= row.genre %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</body>
</html>